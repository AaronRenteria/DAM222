  container: { flex: 1, backgroundColor: '#F2F2F7' },
  headerBackground: { height: 140, justifyContent: 'flex-end' },
  overlay: {
    backgroundColor: 'rgba(0,0,0,0.5)',
    padding: 16,
  },
  tituloHeader: { fontSize: 22, fontWeight: 'bold', color: '#FFF
